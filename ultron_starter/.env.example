# local = Ollama; cloud = OpenAI-compatible chat completions endpoint
ULTRON_PROVIDER=local
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5:3b

# Optional cloud provider settings. Keep real keys in your local .env only.
CLOUD_BASE_URL=https://api.groq.com/openai/v1/chat/completions
CLOUD_MODEL=llama-3.1-8b-instant
CLOUD_API_KEY=

# Optional Vosk offline speech model folder. Download/unzip a Vosk model and set its path.
VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15
ULTRON_DB_PATH=data/ultron.sqlite3
